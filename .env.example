# Copy this file to .env for local testing, and set the same values in
# Vercel -> Project Settings -> Environment Variables for your deployment.

# --- Persistent storage (REQUIRED on Vercel) -------------------------------
# Connection string of a Redis database. On Vercel: Storage tab -> Create ->
# Upstash Redis -> Connect to this project. Vercel adds REDIS_URL / KV_URL
# for you; you normally do NOT have to type anything here.
# Leave empty for local desktop mode (python desktop.py) — it then uses memory.
REDIS_URL=

# --- Security --------------------------------------------------------------
# Shared secret the ESP32 must send in the "X-API-Key" header on POST /update.
# Must match API_KEY in firmware/Brassica_ESP32/config.h. Strongly recommended
# for a public *.vercel.app URL. Leave empty for home-LAN testing.
BRASSICA_API_KEY=

# PIN that must be typed on the dashboard before the ESP32's Wi-Fi network can
# be changed from the website. Strongly recommended on Vercel, otherwise anyone
# who knows your URL could change it.
BRASSICA_ADMIN_PIN=

# --- Optional --------------------------------------------------------------
# Time zone used for history/exports (Vercel itself runs in UTC).
BRASSICA_TZ=Asia/Manila

# Seconds without an ESP32 report before the dashboard says "disconnected".
BRASSICA_DISCONNECT_TIMEOUT=20

# "true" turns on live reload (desktop.py enables it automatically). Leave
# unset / "false" on Vercel.
BRASSICA_DEV_MODE=false
